{
	"$schema": "./node_modules/@emdash-cms/plugin-cli/schemas/emdash-plugin.schema.json",

	"slug": "auto-thumbnail",
	"publisher": "did:plc:myrtyr2rsjiivzlp5m6qevv5",

	"license": "MIT",
	"author": { "name": "Rie Tamura", "url": "https://bsky.app/profile/connectobasan.com" },
	"security": { "url": "https://github.com/RieTamura/Auto-Thumbnail/issues" },
	"name": "Auto Thumbnail",
	"description": "One thumbnail design for posts without an image. Set it in the admin; a client such as Post To EmDash draws the title and date on it.",
	"keywords": ["thumbnail", "featured-image", "og-image", "design", "obsidian"],
	"repo": "https://github.com/RieTamura/Auto-Thumbnail",

	// Trust contract — what runtime APIs the plugin asks for.
	// Changing these between releases requires a version bump because
	// installed users have consented to the old contract.
	"capabilities": [
		// List images in the admin so the background and logo can be chosen.
		"media:read",
		// Hand the chosen background and logo to the client that draws the thumbnail.
		"media:bytes:read"
	],
	"allowedHosts": [],

	"admin": {
		"pages": [{ "path": "/design", "label": "Thumbnail", "icon": "image" }],
		"settingsSchema": {
			"language": {
				"label": "Language / 表示する言語",
				"description": "Language of the Thumbnail page. Auto follows the admin's language. / 「サムネイル」ページの言語。自動は管理画面の言語に合わせます。",
				"type": "select",
				"options": [
					{ "value": "auto", "label": "Auto / 自動" },
					{ "value": "ja", "label": "日本語" },
					{ "value": "en", "label": "English" }
				],
				"default": "auto"
			}
		}
	}
}

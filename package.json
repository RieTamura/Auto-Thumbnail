{
	"name": "auto-thumbnail",
	"version": "0.1.0",
	"description": "One thumbnail design for every post without an image. Set it in the admin; a client such as Post To EmDash draws the title and date on it.",
	"private": true,
	"type": "module",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/RieTamura/Auto-Thumbnail.git"
	},
	"packageManager": "npm@11.13.0",
	"main": "dist/index.mjs",
	"exports": {
		".": {
			"import": "./dist/index.mjs",
			"types": "./dist/index.d.mts"
		},
		"./sandbox": "./dist/plugin.mjs"
	},
	"files": [
		"dist",
		"emdash-plugin.jsonc"
	],
	"scripts": {
		"validate": "emdash-plugin validate",
		"build": "emdash-plugin build",
		"prepare": "emdash-plugin build",
		"dev": "emdash-plugin dev",
		"typecheck": "tsc --noEmit",
		"test": "emdash-plugin validate && vitest run",
		"bundle": "emdash-plugin bundle",
		"login": "emdash-plugin login",
		"publish": "emdash-plugin publish",
		"release:setup": "emdash-plugin release setup"
	},
	"peerDependencies": {
		"emdash": ">=1.3.0"
	},
	"devDependencies": {
		"@emdash-cms/plugin-cli": "0.13.4",
		"@emdash-cms/plugin-test": "^0.2.10",
		"emdash": "^1.3.0",
		"typescript": "^5.9.0",
		"vitest": "^4.1.0"
	}
}
